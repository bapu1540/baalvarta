{
  "entities": {
    "Story": {
      "title": "Story",
      "description": "Children's story in Gujarati/Hindi with translations, audio, quiz, and moral values",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titleHi": { "type": "string" },
        "titleEn": { "type": "string" },
        "category": { "type": "string" },
        "ageGroup": { "type": "string" },
        "synopsisHi": { "type": "string" },
        "synopsisEn": { "type": "string" },
        "moralHi": { "type": "string" },
        "moralEn": { "type": "string" },
        "coverImage": { "type": "string" },
        "contentHi": { "type": "string" },
        "contentEn": { "type": "string" },
        "viewsCount": { "type": "number" },
        "_syncedAt": { "type": "number" }
      },
      "required": ["id", "titleHi", "category"]
    },
    "Worksheet": {
      "title": "Worksheet",
      "description": "Educational printable coloring, tracing, and puzzle worksheet for kids",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titleHi": { "type": "string" },
        "titleEn": { "type": "string" },
        "category": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "printUrl": { "type": "string" },
        "ageGroup": { "type": "string" },
        "descriptionHi": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "createdAt": { "type": "number" },
        "_syncedAt": { "type": "number" }
      },
      "required": ["id", "titleHi", "category", "thumbnailUrl"]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "User engagement events and story view metrics for content strategy optimization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventType": { "type": "string" },
        "targetId": { "type": "string" },
        "targetTitle": { "type": "string" },
        "category": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "eventType", "targetId", "timestamp"]
    },
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Firebase Firestore health check document",
      "type": "object",
      "properties": {
        "lastPing": { "type": "string" },
        "client": { "type": "string" }
      },
      "required": ["lastPing"]
    },
    "AuthOtp": {
      "title": "AuthOtp",
      "description": "Secure OTP record for Firebase phone and email authentication",
      "type": "object",
      "properties": {
        "identifier": { "type": "string" },
        "type": { "type": "string" },
        "otpCode": { "type": "string" },
        "expiresAt": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["identifier", "type", "otpCode", "expiresAt"]
    },
    "VideoStory": {
      "title": "VideoStory",
      "description": "Animated educational children video story",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titleHi": { "type": "string" },
        "titleEn": { "type": "string" },
        "youtubeUrl": { "type": "string" },
        "category": { "type": "string" },
        "thumbnail": { "type": "string" }
      },
      "required": ["id", "titleHi", "youtubeUrl"]
    },
    "FunFact": {
      "title": "FunFact",
      "description": "Curious fun science and nature fact for kids",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titleHi": { "type": "string" },
        "factHi": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "titleHi", "factHi"]
    },
    "LearningItem": {
      "title": "LearningItem",
      "description": "Early learning alphabet, number, or word flashcard",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "module": { "type": "string" },
        "symbol": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "module", "symbol", "name"]
    },
    "AudioStory": {
      "title": "AudioStory",
      "description": "Bedtime audio story with narrator voice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titleHi": { "type": "string" },
        "audioUrl": { "type": "string" }
      },
      "required": ["id", "titleHi", "audioUrl"]
    },
    "QuizSet": {
      "title": "QuizSet",
      "description": "Interactive multiple choice quiz set for kids",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titleHi": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "titleHi"]
    },
    "SiteContent": {
      "title": "SiteContent",
      "description": "General site configuration, footer image, and branding metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Parent email subscriber for weekly moral story updates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "subscribedAt": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "email"]
    },
    "SiteStats": {
      "title": "SiteStats",
      "description": "Aggregated site visitor and impression counters",
      "type": "object",
      "properties": {
        "totalVisits": { "type": "number" },
        "lastVisitedAt": { "type": "string" }
      },
      "required": ["totalVisits"]
    }
  },
  "firestore": {
    "/stories/{storyId}": {
      "schema": "Story",
      "description": "Public stories repository synced across all devices"
    },
    "/worksheets/{worksheetId}": {
      "schema": "Worksheet",
      "description": "Public printable worksheets collection"
    },
    "/video_stories/{videoId}": {
      "schema": "VideoStory",
      "description": "Animated video stories collection"
    },
    "/fun_facts/{factId}": {
      "schema": "FunFact",
      "description": "Fun science and nature facts collection"
    },
    "/early_learning/{itemId}": {
      "schema": "LearningItem",
      "description": "Early learning and alphabet items collection"
    },
    "/audio_stories/{audioId}": {
      "schema": "AudioStory",
      "description": "Bedtime audio stories collection"
    },
    "/quiz_sets/{quizId}": {
      "schema": "QuizSet",
      "description": "Interactive quiz sets collection"
    },
    "/site_content/{contentId}": {
      "schema": "SiteContent",
      "description": "Site content and branding collection"
    },
    "/newsletter_subscribers/{subscriberId}": {
      "schema": "NewsletterSubscriber",
      "description": "Newsletter email subscribers collection"
    },
    "/site_stats/{statId}": {
      "schema": "SiteStats",
      "description": "Website visitor analytics and counters"
    },
    "/analytics_events/{eventId}": {
      "schema": "AnalyticsEvent",
      "description": "User engagement and content analytics events"
    },
    "/_connection_test/{testId}": {
      "schema": "ConnectionTest",
      "description": "Connection test heartbeat document"
    },
    "/auth_otps/{otpId}": {
      "schema": "AuthOtp",
      "description": "Secure OTP records for Firebase phone and email authentication"
    }
  }
}
