rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /_connection_test/{testId} {
      allow read, write: if isValidId(testId);
    }

    match /stories/{storyId} {
      allow read: if true;
      allow write: if isValidId(storyId);
    }

    match /worksheets/{worksheetId} {
      allow read: if true;
      allow write: if isValidId(worksheetId);
    }

    match /video_stories/{videoId} {
      allow read: if true;
      allow write: if isValidId(videoId);
    }

    match /fun_facts/{factId} {
      allow read: if true;
      allow write: if isValidId(factId);
    }

    match /early_learning/{itemId} {
      allow read: if true;
      allow write: if isValidId(itemId);
    }

    match /audio_stories/{audioId} {
      allow read: if true;
      allow write: if isValidId(audioId);
    }

    match /quiz_sets/{quizId} {
      allow read: if true;
      allow write: if isValidId(quizId);
    }

    match /site_content/{contentId} {
      allow read: if true;
      allow write: if isValidId(contentId);
    }

    match /newsletter_subscribers/{subscriberId} {
      allow read: if true;
      allow write: if isValidId(subscriberId);
    }

    match /site_stats/{statId} {
      allow read: if true;
      allow write: if isValidId(statId);
    }

    match /analytics_events/{eventId} {
      allow read: if true;
      allow write: if isValidId(eventId);
    }
  }
}
